        <button class="viewer-nav-btn prev" onclick="viewerPrevImage()">‹</button>
        <div class="viewer-container">
            <img id="viewerImage" class="viewer-image" src="" alt="Zoomed Image">
            <div class="viewer-caption" id="viewerCaption">Image 1 of 3</div>
        </div>
        <button class="viewer-nav-btn next" onclick="viewerNextImage()">›</button>
    </div>

    <script>
        // ==========================================
        // PRODUCT DATA - 3 IMAGES PER PRODUCT
        // ==========================================
        const products = [
            {
                id: 1,
                title: "Wireless Bluetooth Headphones - Premium Noise Cancelling",
                price: 79.99,
                rating: 5,
                stock: 15,
                category: "Electronics",
                images: [
                    "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&h=600&fit=crop",
