                rating: 5,
                stock: 22,
                category: "Accessories",
                images: [
                    "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=800&h=600&fit=crop",
                    "https://images.unsplash.com/photo-1622560480605-d83c853bc5c3?w=800&h=600&fit=crop",
                    "https://images.unsplash.com/photo-1622560481044-8d8c16d66059?w=800&h=600&fit=crop"
                ],
                description: "Durable and stylish backpack with padded laptop compartment (fits up to 17 inches), multiple organizational pockets, USB charging port, and water-resistant material. Perfect for work, school, or travel."
            },
            {
                id: 4,
                title: "Mechanical Gaming Keyboard - RGB Backlit",
                price: 129.99,
                rating: 5,
                stock: 12,
                category: "Electronics",
                images: [
                    "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=800&h=600&fit=crop",
                    "https://images.unsplash.com/photo-1595225476474-87563907a212?w=800&h=600&fit=crop",
                    "https://images.unsplash.com/photo-1511467687858-23d96c32e4ae?w=800&h=600&fit=crop"
                ],
