                price: 89.99,
                rating: 5,
                stock: 10,
                category: "Electronics",
                images: [
                    "https://images.unsplash.com/photo-1614624532983-4ce03382d63d?w=800&h=600&fit=crop",
                    "https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?w=800&h=600&fit=crop",
                    "https://images.unsplash.com/photo-1593085512500-5d55148d6f0d?w=800&h=600&fit=crop"
                ],
                description: "Crystal-clear 4K video quality with auto-focus, built-in dual microphones, and adjustable field of view. Perfect for streaming, video calls, and content creation. Compatible with all major platforms."
            }
        ];

        // ==========================================
        // STATE MANAGEMENT
        // ==========================================
        let currentUser = null;
        let galleryTimers = {};
        let currentViewerProduct = null;
        let currentViewerIndex = 0;
        let tempRating = 0;

        // ==========================================
        // USER AUTHENTICATION
        // ==========================================
        
        function loadUser() {
            const savedUser = localStorage.getItem('currentUser');
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                updateUserSection();
            }
        }

        function showLoginPrompt() {
            const name = prompt('Please enter your name to continue shopping:');
            if (name && name.trim()) {
                currentUser = {
                    id: Date.now(),
                    name: name.trim(),
                    email: name.trim().toLowerCase().replace(/\s/g, '') + '@shopzone.com'
                };
                localStorage.setItem('currentUser', JSON.stringify(currentUser));
                updateUserSection();
                renderCart();
                alert(`Welcome, ${currentUser.name}! You can now add items to your cart.`);
            }
        }

        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                currentUser = null;
                localStorage.removeItem('currentUser');
                updateUserSection();
                renderCart();
            }
        }

        function updateUserSection() {
            const userSection = document.getElementById('userSection');
            if (currentUser) {
                userSection.innerHTML = `
                    <div class="user-info">Hello, ${currentUser.name}</div>
                    <button class="btn" onclick="logout()">Logout</button>
                `;
            } else {
                userSection.innerHTML = `
                    <button class="btn" onclick="showLoginPrompt()">Sign In</button>
                `;
            }
        }

        // ==========================================
        // CART MANAGEMENT - USER-SPECIFIC STORAGE
        // ==========================================
        
        function getUserCart() {
            if (!currentUser) return [];
            const cartKey = `cart_${currentUser.id}`;
            return JSON.parse(localStorage.getItem(cartKey) || '[]');
        }

        function saveUserCart(cart) {
            if (!currentUser) return;
            const cartKey = `cart_${currentUser.id}`;
            localStorage.setItem(cartKey, JSON.stringify(cart));
        }

        function addToCart(productId, event) {
            if (event) event.stopPropagation();
            
            if (!currentUser) {
                alert('Please sign in to add items to your cart!');
                showLoginPrompt();
                return;
            }

            const product = products.find(p => p.id === productId);
            if (!product || product.stock === 0) {
                alert('Sorry, this product is out of stock!');
                return;
            }

            let cart = getUserCart();
            const existingItem = cart.find(item => item.id === productId);

            if (existingItem) {
                if (existingItem.quantity < product.stock) {
                    existingItem.quantity++;
                } else {
                    alert(`Only ${product.stock} items available in stock!`);
                    return;
                }
            } else {
                cart.push({
                    ...product,
                    quantity: 1
                });
            }

            saveUserCart(cart);
            renderCart();
            
            // Show success feedback
            const btn = event ? event.target : null;
            if (btn) {
                const originalText = btn.textContent;
                btn.textContent = '✓ Added!';
                btn.style.background = '#4CAF50';
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.style.background = '';
                }, 1000);
            }
        }

        function updateQuantity(productId, change) {
            let cart = getUserCart();
            const item = cart.find(i => i.id === productId);
            
            if (!item) return;

            const newQuantity = item.quantity + change;
            const product = products.find(p => p.id === productId);

            if (newQuantity <= 0) {
                removeFromCart(productId);
            } else if (newQuantity <= product.stock) {
                item.quantity = newQuantity;
                saveUserCart(cart);
                renderCart();
            } else {
                alert(`Only ${product.stock} items available in stock!`);
            }
        }

        function removeFromCart(productId) {
            let cart = getUserCart();
            cart = cart.filter(item => item.id !== productId);
            saveUserCart(cart);
            renderCart();
        }

        function clearCart() {
            if (confirm('Are you sure you want to clear your cart?')) {
                saveUserCart([]);
                renderCart();
            }
        }

        function checkout() {
            const cart = getUserCart();
            if (cart.length === 0) {
                alert('Your cart is empty!');
                return;
            }

            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const itemCount = cart.reduce((sum, item) => sum + item.quantity, 0);

            alert(`
✅ Order Successful!

Thank you for your purchase, ${currentUser.name}!

Items: ${itemCount}
Total: $${total.toFixed(2)}

Order confirmation sent to: ${currentUser.email}

(This is a demo - no actual payment processed)
            `);

            saveUserCart([]);
            renderCart();
        }

        function renderCart() {
            const cart = getUserCart();
            const cartContent = document.getElementById('cartContent');
            const cartSummary = document.getElementById('cartSummary');
            const cartBadge = document.getElementById('cartBadge');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartBadge.textContent = totalItems;

            if (cart.length === 0) {
                cartContent.innerHTML = `
                    <div class="cart-empty">
                        <div class="cart-empty-icon">🛒</div>
                        <p>Your cart is empty</p>
                        <p style="font-size: 14px; margin-top: 10px;">Start adding some products!</p>
                    </div>
                `;
                cartSummary.style.display = 'none';
                return;
            }

            let cartHTML = '';
            let total = 0;

            cart.forEach(item => {
                const subtotal = item.price * item.quantity;
                total += subtotal;

                cartHTML += `
                    <div class="cart-item">
                        <img src="${item.images[0]}" class="cart-item-image" alt="${item.title}">
                        <div class="cart-item-details">
                            <div class="cart-item-title">${item.title}</div>
                            <div class="cart-item-price">$${item.price.toFixed(2)}</div>
                            <div class="quantity-controls">
                                <button class="qty-btn" onclick="updateQuantity(${item.id}, -1)">−</button>
                                <span class="qty-display">${item.quantity}</span>
                                <button class="qty-btn" onclick="updateQuantity(${item.id}, 1)">+</button>
                            </div>
                            <button class="remove-btn" onclick="removeFromCart(${item.id})">Remove</button>
                        </div>
                    </div>
                `;
            });

            cartContent.innerHTML = cartHTML;

            cartSummary.style.display = 'block';
            cartSummary.innerHTML = `
                <div class="cart-summary">
                    <div class="cart-total">
                        <span>Total:</span>
                        <span>$${total.toFixed(2)}</span>
                    </div>
                    <button class="checkout-btn" onclick="checkout()">
                        Proceed to Checkout (${totalItems} item${totalItems > 1 ? 's' : ''})
                    </button>
                    <button class="clear-cart-btn" onclick="clearCart()">Clear Cart</button>
                </div>
            `;
        }

        function scrollToCart() {
            document.querySelector('.cart-sidebar').scrollIntoView({ 
                behavior: 'smooth',
                block: 'start'
            });
        }

        // ==========================================
        // AUTO-SWIPE IMAGE GALLERY
        // ==========================================
        
        function startAutoSwipe(productId) {
            // Auto-swipe every 5 seconds
            galleryTimers[productId] = setInterval(() => {
                const gallery = document.querySelector(`[data-product-id="${productId}"]`);
                if (!gallery) {
                    stopAutoSwipe(productId);
                    return;
                }

                const currentIndex = parseInt(gallery.dataset.currentIndex || 0);
                const product = products.find(p => p.id === productId);
                const nextIndex = (currentIndex + 1) % product.images.length;
                
                updateGallery(productId, nextIndex);
            }, 5000); // 5 seconds
        }

        function stopAutoSwipe(productId) {
            if (galleryTimers[productId]) {
                clearInterval(galleryTimers[productId]);
                delete galleryTimers[productId];
            }
        }

        function updateGallery(productId, index) {
            const gallery = document.querySelector(`[data-product-id="${productId}"]`);
            if (!gallery) return;

            const product = products.find(p => p.id === productId);
            gallery.dataset.currentIndex = index;

            // Update image position
            const track = gallery.querySelector('.gallery-track');
            track.style.transform = `translateX(-${index * 100}%)`;

            // Update counter
            const counter = gallery.querySelector('.image-counter');
            counter.textContent = `${index + 1}/${product.images.length}`;

            // Update dots
            const dots = gallery.querySelectorAll('.dot');
            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === index);
            });
        }

        function jumpToImage(productId, index, event) {
            event.stopPropagation();
            updateGallery(productId, index);
            // Reset auto-swipe timer
            stopAutoSwipe(productId);
            startAutoSwipe(productId);
        }

        // ==========================================
        // PRODUCT DISPLAY
        // ==========================================
        
        function renderProducts() {
            const grid = document.getElementById('productsGrid');
            
            grid.innerHTML = products.map(product => {
                const comments = getProductComments(product.id);
                const avgRating = comments.length > 0 
                    ? Math.round(comments.reduce((sum, c) => sum + c.rating, 0) / comments.length)
                    : product.rating;

                const stockClass = product.stock === 0 ? 'out-of-stock' : product.stock < 10 ? 'low-stock' : '';
                const stockText = product.stock === 0 ? 'Out of Stock' : 
                                 product.stock < 10 ? `Only ${product.stock} left!` : 
                                 `In Stock (${product.stock})`;

                return `
                    <div class="product-card" onclick="openProductDetail(${product.id})">
                        <div class="image-gallery" data-product-id="${product.id}" data-current-index="0">
                            <div class="gallery-track">
                                ${product.images.map(img => 
                                    `<img src="${img}" class="gallery-image" alt="${product.title}">`
                                ).join('')}
                            </div>
                            <div class="image-counter">1/${product.images.length}</div>
                            <div class="gallery-dots">
                                ${product.images.map((_, i) => 
                                    `<div class="dot ${i === 0 ? 'active' : ''}" 
                                          onclick="jumpToImage(${product.id}, ${i}, event)"></div>`
                                ).join('')}
                            </div>
                        </div>
                        
                        <div class="product-info">
                            <div class="product-title">${product.title}</div>
                            <div class="product-rating">
                                <span class="stars">${'★'.repeat(avgRating)}${'☆'.repeat(5 - avgRating)}</span>
                                ${comments.length > 0 ? `<span class="review-count">(${comments.length})</span>` : ''}
                            </div>
                            <div class="product-price">$${product.price.toFixed(2)}</div>
                            <div class="stock-info ${stockClass}">${stockText}</div>
                            <button class="add-to-cart-btn" 
                                    onclick="addToCart(${product.id}, event)"
                                    ${product.stock === 0 ? 'disabled' : ''}>
                                ${product.stock === 0 ? 'Out of Stock' : 'Add to Cart'}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            // Start auto-swipe for all products
            products.forEach(product => {
                startAutoSwipe(product.id);
            });
        }

        // ==========================================
        // PRODUCT DETAIL MODAL
        // ==========================================
        
        let detailGalleryIndex = 0;
        let detailGalleryTimer = null;

        function openProductDetail(productId) {
            const product = products.find(p => p.id === productId);
            const comments = getProductComments(productId);
            const avgRating = comments.length > 0 
                ? Math.round(comments.reduce((sum, c) => sum + c.rating, 0) / comments.length)
                : product.rating;

            detailGalleryIndex = 0;

            const modalBody = document.getElementById('modalBody');
            modalBody.innerHTML = `
                <div class="modal-header">
                    <h2 class="modal-title">${product.title}</h2>
                </div>

                <div class="detail-gallery" id="detailGallery" data-current-index="0">
                    <button class="gallery-nav-btn prev" onclick="detailPrevImage(event)">‹</button>
                    <button class="gallery-nav-btn next" onclick="detailNextImage(event)">›</button>
                    
                    <div class="detail-gallery-track">
                        ${product.images.map((img, idx) => 
                            `<img src="${img}" class="detail-gallery-image" 
                                  onclick="openImageViewer(${productId}, ${idx}, event)" 
                                  alt="${product.title} - Image ${idx + 1}">`
                        ).join('')}
                    </div>
                    
                    <div class="detail-image-counter">1/${product.images.length}</div>
                    <div class="detail-gallery-dots">
                        ${product.images.map((_, i) => 
                            `<div class="detail-dot ${i === 0 ? 'active' : ''}" 
                                  onclick="detailJumpToImage(${i}, event)"></div>`
                        ).join('')}
                    </div>
                </div>

                <p class="zoom-hint">💡 Click on images to view in full size</p>

                <div class="product-details">
                    <div class="detail-section">
                        <div class="detail-label">Price</div>
                        <div class="detail-value" style="color: #b12704; font-size: 28px;">$${product.price.toFixed(2)}</div>
                    </div>
                    <div class="detail-section">
                        <div class="detail-label">Rating</div>
                        <div class="detail-value" style="color: #ffa41c;">
                            ${'★'.repeat(avgRating)}${'☆'.repeat(5 - avgRating)}
                            ${comments.length > 0 ? `<span style="font-size: 14px; color: #666;"> (${comments.length} reviews)</span>` : ''}
                        </div>
                    </div>
                    <div class="detail-section">
                        <div class="detail-label">Category</div>
                        <div class="detail-value">${product.category}</div>
                    </div>
                    <div class="detail-section">
                        <div class="detail-label">Availability</div>
                        <div class="detail-value" style="color: ${product.stock > 0 ? '#007600' : '#c7511f'};">
                            ${product.stock > 0 ? `In Stock (${product.stock} available)` : 'Out of Stock'}
                        </div>
                    </div>
                </div>

                <div class="description">${product.description}</div>

                <button class="add-to-cart-btn" style="max-width: 400px; margin: 0 auto 30px; display: block;"
                        onclick="addToCart(${product.id}, event); closeProductModal();"
                        ${product.stock === 0 ? 'disabled' : ''}>
                    ${product.stock === 0 ? 'Out of Stock' : 'Add to Cart & Continue Shopping'}
                </button>

                ${renderReviewsSection(productId)}
            `;

            document.getElementById('productModal').classList.add('active');
            startDetailAutoSwipe();
        }

        function closeProductModal() {
            document.getElementById('productModal').classList.remove('active');
            stopDetailAutoSwipe();
            tempRating = 0;
        }

        function startDetailAutoSwipe() {
            detailGalleryTimer = setInterval(() => {
                const gallery = document.getElementById('detailGallery');
                if (!gallery) {
                    stopDetailAutoSwipe();
                    return;
                }

                const currentIndex = parseInt(gallery.dataset.currentIndex || 0);
                const images = gallery.querySelectorAll('.detail-gallery-image');
                const nextIndex = (currentIndex + 1) % images.length;
                
                updateDetailGallery(nextIndex);
            }, 5000);
        }

        function stopDetailAutoSwipe() {
            if (detailGalleryTimer) {
                clearInterval(detailGalleryTimer);
                detailGalleryTimer = null;
            }
        }

        function updateDetailGallery(index) {
            const gallery = document.getElementById('detailGallery');
            if (!gallery) return;

            gallery.dataset.currentIndex = index;
            
            // Update image position
            const track = gallery.querySelector('.detail-gallery-track');
            track.style.transform = `translateX(-${index * 100}%)`;

            // Update counter
            const images = gallery.querySelectorAll('.detail-gallery-image');
            const counter = gallery.querySelector('.detail-image-counter');
            counter.textContent = `${index + 1}/${images.length}`;

            // Update dots
            const dots = gallery.querySelectorAll('.detail-dot');
            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === index);
            });
        }

        function detailPrevImage(event) {
            event.stopPropagation();
            const gallery = document.getElementById('detailGallery');
            const currentIndex = parseInt(gallery.dataset.currentIndex || 0);
            const images = gallery.querySelectorAll('.detail-gallery-image');
            const newIndex = (currentIndex - 1 + images.length) % images.length;
            updateDetailGallery(newIndex);
            stopDetailAutoSwipe();
            startDetailAutoSwipe();
        }

        function detailNextImage(event) {
            event.stopPropagation();
            const gallery = document.getElementById('detailGallery');
            const currentIndex = parseInt(gallery.dataset.currentIndex || 0);
            const images = gallery.querySelectorAll('.detail-gallery-image');
            const newIndex = (currentIndex + 1) % images.length;
            updateDetailGallery(newIndex);
            stopDetailAutoSwipe();
            startDetailAutoSwipe();
        }

        function detailJumpToImage(index, event) {
            event.stopPropagation();
            updateDetailGallery(index);
            stopDetailAutoSwipe();
            startDetailAutoSwipe();
        }

        // ==========================================
        // IMAGE ZOOM VIEWER
        // ==========================================
        
        function openImageViewer(productId, imageIndex, event) {
            event.stopPropagation();
            
            const product = products.find(p => p.id === productId);
            currentViewerProduct = product;
            currentViewerIndex = imageIndex;

            const viewer = document.getElementById('imageViewer');
            const viewerImage = document.getElementById('viewerImage');
            const viewerCaption = document.getElementById('viewerCaption');

            viewerImage.src = product.images[imageIndex];
            viewerCaption.textContent = `Image ${imageIndex + 1} of ${product.images.length}`;
            
            viewer.classList.add('active');
        }

        function closeImageViewer() {
            document.getElementById('imageViewer').classList.remove('active');
        }

        function viewerPrevImage() {
            if (!currentViewerProduct) return;
            
            currentViewerIndex = (currentViewerIndex - 1 + currentViewerProduct.images.length) % currentViewerProduct.images.length;
            
            const viewerImage = document.getElementById('viewerImage');
            const viewerCaption = document.getElementById('viewerCaption');
            
            viewerImage.src = currentViewerProduct.images[currentViewerIndex];
            viewerCaption.textContent = `Image ${currentViewerIndex + 1} of ${currentViewerProduct.images.length}`;
        }

        function viewerNextImage() {
            if (!currentViewerProduct) return;
            
            currentViewerIndex = (currentViewerIndex + 1) % currentViewerProduct.images.length;
            
            const viewerImage = document.getElementById('viewerImage');
            const viewerCaption = document.getElementById('viewerCaption');
            
            viewerImage.src = currentViewerProduct.images[currentViewerIndex];
            viewerCaption.textContent = `Image ${currentViewerIndex + 1} of ${currentViewerProduct.images.length}`;
        }

        // Close viewer on ESC key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeImageViewer();
                closeProductModal();
            }
        });

        // ==========================================
        // REVIEWS & RATINGS SYSTEM
        // ==========================================
        
        function getProductComments(productId) {
            const key = `comments_product_${productId}`;
            return JSON.parse(localStorage.getItem(key) || '[]');
        }

        function saveProductComment(productId, comment) {
            const key = `comments_product_${productId}`;
            const comments = getProductComments(productId);
            comments.unshift(comment); // Add to beginning
            localStorage.setItem(key, JSON.stringify(comments));
        }

        function setRating(rating) {
            tempRating = rating;
            for (let i = 1; i <= 5; i++) {
                const star = document.getElementById(`star-${i}`);
                if (star) {
                    star.classList.toggle('selected', i <= rating);
                }
            }
        }

        function submitReview(productId) {
            if (!currentUser) {
                alert('Please sign in to leave a review!');
                showLoginPrompt();
                return;
            }

            if (tempRating === 0) {
                alert('Please select a rating!');
                return;
            }

            const textarea = document.getElementById('reviewText');
            const reviewText = textarea.value.trim();

            if (!reviewText) {
                alert('Please write a review!');
                return;
            }

            const comment = {
                userName: currentUser.name,
                userId: currentUser.id,
                rating: tempRating,
                text: reviewText,
                date: new Date().toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                })
            };

            saveProductComment(productId, comment);
            
            // Refresh the modal to show new review
            openProductDetail(productId);
            
            alert('Thank you for your review!');
        }

        function renderReviewsSection(productId) {
            const comments = getProductComments(productId);
            
            return `
                <div class="reviews-section">
                    <h3 class="reviews-title">Customer Reviews (${comments.length})</h3>

                    ${currentUser ? `
                        <div class="review-form">
                            <div class="rating-input">
                                <label class="rating-label">Your Rating:</label>
                                <div class="star-rating">
                                    ${[1,2,3,4,5].map(num => 
                                        `<button type="button" class="star-btn" id="star-${num}" 
                                                 onclick="setRating(${num})">★</button>`
                                    ).join('')}
                                </div>
                            </div>
                            <textarea id="reviewText" class="review-textarea" 
                                      placeholder="Share your experience with this product..."></textarea>
                            <button class="submit-review-btn" onclick="submitReview(${productId})">
                                Submit Review
                            </button>
                        </div>
                    ` : `
                        <div class="review-form" style="text-align: center; padding: 30px;">
                            <p style="margin-bottom: 15px;">Please sign in to leave a review</p>
                            <button class="btn" onclick="showLoginPrompt(); closeProductModal();">Sign In</button>
                        </div>
                    `}

                    <div class="reviews-list">
                        ${comments.length === 0 ? `
                            <div class="no-reviews">
                                No reviews yet. Be the first to review this product!
                            </div>
                        ` : comments.map(comment => `
                            <div class="review-card">
                                <div class="review-header">
                                    <span class="review-author">${comment.userName}</span>
                                    <span class="review-date">${comment.date}</span>
                                </div>
                                <div class="review-stars">${'★'.repeat(comment.rating)}${'☆'.repeat(5 - comment.rating)}</div>
                                <div class="review-text">${comment.text}</div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        // ==========================================
        // SEARCH FUNCTIONALITY
        // ==========================================
        
        function searchProducts() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            
            if (!query) {
                renderProducts();
                return;
            }

            const filtered = products.filter(p => 
                p.title.toLowerCase().includes(query) ||
                p.description.toLowerCase().includes(query) ||
                p.category.toLowerCase().includes(query)
            );

            const grid = document.getElementById('productsGrid');
            
            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div style="grid-column: 1/-1; text-align: center; padding: 80px 20px;">
                        <div style="font-size: 80px; margin-bottom: 20px;">🔍</div>
                        <h3 style="font-size: 24px; margin-bottom: 10px;">No products found</h3>
                        <p style="color: #666;">Try different keywords or <a href="#" onclick="location.reload()" style="color: #ff9900;">browse all products</a></p>
                    </div>
                `;
                return;
            }

            // Render filtered products
            grid.innerHTML = filtered.map(product => {
                const comments = getProductComments(product.id);
                const avgRating = comments.length > 0 
                    ? Math.round(comments.reduce((sum, c) => sum + c.rating, 0) / comments.length)
                    : product.rating;

                const stockClass = product.stock === 0 ? 'out-of-stock' : product.stock < 10 ? 'low-stock' : '';
                const stockText = product.stock === 0 ? 'Out of Stock' : 
                                 product.stock < 10 ? `Only ${product.stock} left!` : 
                                 `In Stock (${product.stock})`;

                return `
                    <div class="product-card" onclick="openProductDetail(${product.id})">
                        <div class="image-gallery" data-product-id="${product.id}" data-current-index="0">
                            <div class="gallery-track">
                                ${product.images.map(img => 
                                    `<img src="${img}" class="gallery-image" alt="${product.title}">`
                                ).join('')}
                            </div>
                            <div class="image-counter">1/${product.images.length}</div>
                            <div class="gallery-dots">
                                ${product.images.map((_, i) => 
                                    `<div class="dot ${i === 0 ? 'active' : ''}" 
                                          onclick="jumpToImage(${product.id}, ${i}, event)"></div>`
                                ).join('')}
                            </div>
                        </div>
                        
                        <div class="product-info">
                            <div class="product-title">${product.title}</div>
                            <div class="product-rating">
                                <span class="stars">${'★'.repeat(avgRating)}${'☆'.repeat(5 - avgRating)}</span>
                                ${comments.length > 0 ? `<span class="review-count">(${comments.length})</span>` : ''}
                            </div>
                            <div class="product-price">$${product.price.toFixed(2)}</div>
                            <div class="stock-info ${stockClass}">${stockText}</div>
                            <button class="add-to-cart-btn" 
                                    onclick="addToCart(${product.id}, event)"
                                    ${product.stock === 0 ? 'disabled' : ''}>
                                ${product.stock === 0 ? 'Out of Stock' : 'Add to Cart'}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            // Start auto-swipe for filtered products
            filtered.forEach(product => {
                startAutoSwipe(product.id);
            });
        }

        // ==========================================
        // INITIALIZATION
        // ==========================================
        
        window.addEventListener('DOMContentLoaded', () => {
            loadUser();
            renderProducts();
            renderCart();
        });

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            Object.keys(galleryTimers).forEach(productId => {
                stopAutoSwipe(parseInt(productId));
            });
            stopDetailAutoSwipe();
        });
    </script>
</body>
</html>

